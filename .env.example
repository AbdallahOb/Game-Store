DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=gamestore
POSTGRES_USER=gamestore
POSTGRES_PASSWORD=gamestore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:4200

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# Only used by backend/docker-entrypoint.sh (the full Docker stack, Option A
# in the README) to create a default login on first start. Not used when
# running the backend locally - use `python manage.py createsuperuser` there.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@example.com
